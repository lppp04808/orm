#!/usr/bin/env php
<?php

declare(strict_types=1);

use Pixiaoka\Orm\ModelGenerator;

$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];
foreach ($autoloads as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(ModelGenerator::class)) {
    fwrite(STDERR, "pixiaoka-orm: Composer autoload not found; run composer install first.\n");
    exit(1);
}

$usage = <<<TEXT
Usage:
  pixiaoka-orm generate --dsn=DSN --dir=DIR --namespace=NAMESPACE [--user=USER] [--password=PASSWORD] [--prefix=PREFIX] [--force] [tables...]

Options:
  --dsn         PDO DSN; supports sqlite, mysql, and pgsql (required)
  --user        Database username; ORM_DB_USER may also be used
  --password    Database password; ORM_DB_PASSWORD may also be used (the option takes precedence)
  --dir         Explicit model output directory (required)
  --namespace   Model PHP namespace, e.g. App\\Model (required)
  --prefix      Table prefix to remove only from generated class names
  --force       Overwrite existing model files
  -h, --help    Show help

Examples:
  pixiaoka-orm generate --dsn='sqlite:/tmp/app.sqlite' --dir='/tmp/models' --namespace='App\\Model'
  pixiaoka-orm generate --dsn='mysql:host=127.0.0.1;dbname=app' --user=app --dir='./models' --namespace='App\\Model' user user_item
TEXT;

/** @return array{options: array<string, string|bool>, tables: list<string>}|null */
function parseGenerateArguments(array $arguments): ?array
{
    $options = [];
    $tables = [];
    $positional = false;
    $count = count($arguments);
    for ($index = 0; $index < $count; $index++) {
        $argument = $arguments[$index];
        if (!$positional && $argument === '--') {
            $positional = true;
            continue;
        }
        if (!$positional && in_array($argument, ['-h', '--help'], true)) {
            return null;
        }
        if (!$positional && $argument === '--force') {
            $options['force'] = true;
            continue;
        }
        if (!$positional && str_starts_with($argument, '--')) {
            $option = substr($argument, 2);
            $equals = strpos($option, '=');
            $name = $equals === false ? $option : substr($option, 0, $equals);
            if (!in_array($name, ['dsn', 'user', 'password', 'dir', 'namespace', 'prefix'], true)) {
                throw new InvalidArgumentException("Unknown option: --$name");
            }
            if (array_key_exists($name, $options)) {
                throw new InvalidArgumentException("Duplicate option: --$name");
            }
            if ($equals !== false) {
                $options[$name] = substr($option, $equals + 1);
            } else {
                $value = $arguments[$index + 1] ?? null;
                if ($value === null || str_starts_with($value, '--')) {
                    throw new InvalidArgumentException("Option --$name requires a value");
                }
                $options[$name] = $value;
                $index++;
            }
            continue;
        }
        $tables[] = $argument;
    }

    return ['options' => $options, 'tables' => $tables];
}

try {
    $arguments = $_SERVER['argv'];
    array_shift($arguments);
    $command = array_shift($arguments);
    if ($command === null || in_array($command, ['-h', '--help', 'help'], true)) {
        fwrite(STDOUT, $usage . PHP_EOL);
        exit($command === null ? 1 : 0);
    }
    if ($command !== 'generate') {
        throw new InvalidArgumentException("Unknown command: $command; only generate is supported");
    }
    $parsed = parseGenerateArguments($arguments);
    if ($parsed === null) {
        fwrite(STDOUT, $usage . PHP_EOL);
        exit(0);
    }
    $options = $parsed['options'];
    foreach (['dsn', 'dir', 'namespace'] as $required) {
        if (!isset($options[$required]) || $options[$required] === '') {
            throw new InvalidArgumentException("Missing required option: --$required");
        }
    }

    $user = $options['user'] ?? getenv('ORM_DB_USER');
    $password = $options['password'] ?? getenv('ORM_DB_PASSWORD');
    $pdo = new PDO(
        (string) $options['dsn'],
        $user === false ? null : (string) $user,
        $password === false ? null : (string) $password,
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
    );
    $result = (new ModelGenerator($pdo))->generate(
        directory: (string) $options['dir'],
        namespace: (string) $options['namespace'],
        prefix: (string) ($options['prefix'] ?? ''),
        force: (bool) ($options['force'] ?? false),
        tables: $parsed['tables'],
    );
    foreach ($result['generated'] as $table => $file) {
        fwrite(STDOUT, "Generated $table -> $file" . PHP_EOL);
    }
    foreach ($result['skipped'] as $table => $file) {
        fwrite(STDOUT, "Skipped $table (exists, use --force): $file" . PHP_EOL);
    }
    fwrite(STDOUT, sprintf('Done: %d generated, %d skipped.', count($result['generated']), count($result['skipped'])) . PHP_EOL);
    exit(0);
} catch (Throwable $error) {
    fwrite(STDERR, 'pixiaoka-orm: ' . $error->getMessage() . PHP_EOL);
    fwrite(STDERR, "Run pixiaoka-orm --help for usage." . PHP_EOL);
    exit(1);
}
